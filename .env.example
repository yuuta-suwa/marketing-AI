# ---------------------------------------------------------------------------
# MARKET RADAR OS — environment contract
# Copy to .env.local. Only NEXT_PUBLIC_* values reach the browser.
# NEVER put secret keys in NEXT_PUBLIC_* variables.
# ---------------------------------------------------------------------------

# --- Supabase (required for production mode) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (or legacy anon) key — safe for the browser, RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Used ONLY by scheduled system jobs (/api/cron/*) — never by user requests.
# Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Bearer secret for /api/cron/* (Vercel Cron sends it automatically). ≥16 chars.
CRON_SECRET=

# --- Local demo (no Supabase) ----------------------------------------------
# true = in-process store with a single demo user. NOT for real data.
# Ignored when NEXT_PUBLIC_SUPABASE_URL is set.
MRO_DEMO_MODE=false

# Demo only: run the real connector adapters against canned responses (items are
# labelled [MOCK] / metadata.synthetic). Ignored outside demo mode.
CONNECTOR_MOCK_MODE=false
# Comma-separated connector ids to simulate failures in mock mode, e.g. "x"
CONNECTOR_MOCK_FAIL=

# --- AI provider ------------------------------------------------------------
# anthropic | none (openai / gemini adapters are planned; the port is provider-agnostic)
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Default: claude-opus-5-5
ANTHROPIC_MODEL=
# low | medium | high (default medium)
ANTHROPIC_EFFORT=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Embeddings ---------------------------------------------------------------
# local (default, zero cost, lexical) | openai (semantic, text-embedding-3-small, 1536 dims)
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=

# --- Connectors (server-side only) -----------------------------------------
# Web search (Brave Search API). Runs only after you confirm your plan permits storing results.
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_STORAGE_RIGHTS_CONFIRMED=false
# e-Stat (政府統計) API application id
ESTAT_APP_ID=
# X API v2 bearer token + confirmation that the developer terms for your tier were reviewed
X_BEARER_TOKEN=
X_TERMS_CONFIRMED=false
# Google Places API (New) — connector is PENDING_REVIEW (content storage terms) and will not run yet
GOOGLE_PLACES_API_KEY=
# Tripadvisor Content API — PENDING_REVIEW (licence for analytical storage) and will not run yet
TRIPADVISOR_API_KEY=

# --- Logging ----------------------------------------------------------------
# Set to print structured logs during vitest runs
MRO_LOG_IN_TESTS=
