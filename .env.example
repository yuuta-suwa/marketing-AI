# ---------------------------------------------------------------------------
# MARKET RADAR OS — environment contract (see docs/ENVIRONMENT.md)
# Source of truth in code: src/infrastructure/env-contract.ts
#
# Categories
#   REQUIRED_FOR_CORE       production does not start / reports 503 without it
#   REQUIRED_FOR_CONNECTOR  a connector/provider is LIVE only with it
#                           (otherwise READY_NEEDS_CREDENTIALS — never silently mocked)
#   OPTIONAL                tuning, limits, optional providers
#   DEVELOPMENT_ONLY        rejected or ignored in production
#
# Only NEXT_PUBLIC_* values reach the browser. NEVER put secrets in NEXT_PUBLIC_*.
# Processes: "web" = Vercel/Next frontend, "worker" = npm run worker (background jobs).
# ---------------------------------------------------------------------------

# === REQUIRED_FOR_CORE =======================================================
# [web, worker] Environment identity: local | staging | production.
# Required for production builds (NODE_ENV=production); security-relevant
# behaviour (mock policy, demo store, embedded worker) depends on it.
APP_ENV=local
# [web, worker] Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=
# [web] Publishable (or legacy anon) key — safe for the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# [worker; web only for /api/cron] Service-role key. Bypasses RLS: the worker scopes
# every query to the job's organization. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# [web] Bearer secret for /api/cron/* (Vercel Cron sends it). ≥ 16 characters.
CRON_SECRET=

# === REQUIRED_FOR_CONNECTOR ==================================================
# Anthropic (LLM agents). Without it every agent uses its deterministic fallback.
ANTHROPIC_API_KEY=
# Brave Search API (web_search). Runs only when your plan permits storing results:
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_STORAGE_RIGHTS_CONFIRMED=false
# e-Stat 政府統計 API application id (estat)
ESTAT_APP_ID=
# X API v2 (x) + confirmation that the developer terms for your tier were reviewed
X_BEARER_TOKEN=
X_TERMS_CONFIRMED=false
# Google Places / Tripadvisor — PENDING_REVIEW (content licence) → will not run yet
GOOGLE_PLACES_API_KEY=
TRIPADVISOR_API_KEY=
# OpenAI — only used with EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=

# === OPTIONAL ================================================================
# anthropic | none (default: anthropic when ANTHROPIC_API_KEY is set).
# An explicit choice whose key is missing is a configuration ERROR (no silent fallback).
AI_PROVIDER=
ANTHROPIC_MODEL=
# low | medium | high (default medium)
ANTHROPIC_EFFORT=
# local (default, zero cost) | openai (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=
# Reserved — adapter not implemented
GEMINI_API_KEY=

# Hard cost / volume limits (cap — never raise — each organization's budgets).
# When reached: completed work is kept, optional work stops, run = PARTIAL_SUCCESS
# with the skipped steps listed. Defaults shown.
MAX_COST_PER_RESEARCH_RUN=1
MAX_DAILY_AI_COST=10
MAX_MONTHLY_AI_COST=100
MAX_SEARCH_REQUESTS_PER_RUN=10
MAX_SOURCE_ITEMS_PER_RUN=200
MAX_LLM_CALLS_PER_RUN=40

# Release identifier shown in worker health (default: VERCEL_GIT_COMMIT_SHA / GIT_COMMIT_SHA / dev)
APP_VERSION=

# Worker tuning
WORKER_ID=
WORKER_CONCURRENCY=1
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=120
# Expose GET /healthz with queue stats on this port (empty = disabled)
WORKER_HEALTH_PORT=
# [web] external (default) | embedded — embedded drains the queue inside `next dev`
# (development only; rejected when NODE_ENV=production)
WORKER_MODE=

# --- Operator tooling (never deployed) ---------------------------------------
# npm run golden-run: existing member/owner of the target org in the hosted project
GOLDEN_RUN_USER_ID=
GOLDEN_RUN_ORG_ID=
GOLDEN_RUN_TIMEOUT_SECONDS=900
# npm run verify:hosted-db (secret connection string — set in your shell, not in a file you commit)
SUPABASE_DB_URL=
# bash scripts/supabase-advisors.sh (Management API)
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# === DEVELOPMENT_ONLY ========================================================
# In-process demo store with one demo user. Rejected when NODE_ENV=production
# unless ENABLE_MOCK_CONNECTORS=true marks an explicit test deployment (E2E).
MRO_DEMO_MODE=false
# Run the real adapters against canned responses (items labelled [MOCK],
# metadata.synthetic=true, persistent MOCK badge in the UI). Allowed only when
# NODE_ENV != production, or with ENABLE_MOCK_CONNECTORS=true (staging/E2E).
# A production process with CONNECTOR_MOCK_MODE=true and no opt-in refuses to run.
# ENABLE_MOCK_CONNECTORS=true = explicit staging/E2E test deployment. Never set it in production.
# Mock policy by APP_ENV — local: allowed · staging: needs ENABLE_MOCK_CONNECTORS=true ·
# production: disabled; an override needs ENABLE_MOCK_CONNECTORS=true AND
# ALLOW_MOCK_IN_PRODUCTION=true and shows "PRODUCTION MOCK OVERRIDE" everywhere.
CONNECTOR_MOCK_MODE=false
ENABLE_MOCK_CONNECTORS=false
ALLOW_MOCK_IN_PRODUCTION=false
# Comma-separated connector ids to simulate failures in mock mode, e.g. "x"
CONNECTOR_MOCK_FAIL=
# Print structured logs during vitest runs
MRO_LOG_IN_TESTS=
