# Background worker for MARKET RADAR OS (not the web app — that deploys to Vercel).
#   docker build -f Dockerfile.worker -t market-radar-worker .
#   docker run --env-file worker.env market-radar-worker
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY tsconfig.json ./
COPY src ./src
COPY scripts/worker.ts scripts/live-smoke.ts ./scripts/
USER node
# SIGTERM → graceful shutdown (stop claiming, finish/release the current job).
STOPSIGNAL SIGTERM
CMD ["npm", "run", "worker"]
